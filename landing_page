        <div class="kl-status mono"><span class="kl-dot"></span> reported · triaged · patched</div>
      </div>
    </div>
    <div class="kl-entry reveal d1">
      <div class="kl-header">
        <span class="kl-sev sev-high">HIGH</span>
        <span class="kl-target mono">target: <span class="redact">████████ · Hospitality</span></span>
        <span class="kl-cvss mono">CVSS 8.6</span>
