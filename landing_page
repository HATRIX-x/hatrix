<script>
  (function(){
    const c=document.getElementById('matrix'),x=c.getContext('2d');
    const glyphs='01</>{}[]#$%&=+*ΑΒΓΔΘΛΞΠΣΦΨΩ𓂀𓁷𓆣𓃭𓅓𓊹𓋹𓇳𓏏𓆓𓎡01ABCDEF'.split('');
    let cols,drops,fs=16;
    function init(){c.width=innerWidth;c.height=innerHeight;cols=Math.floor(c.width/fs);drops=Array(cols).fill(0).map(()=>Math.random()*-c.height/fs);}
    init();addEventListener('resize',init);
    function draw(){
      x.fillStyle='rgba(6,6,5,0.09)';x.fillRect(0,0,c.width,c.height);
      x.font=fs+'px JetBrains Mono, monospace';
      for(let i=0;i<cols;i++){
        const g=glyphs[Math.floor(Math.random()*glyphs.length)];const y=drops[i]*fs;
        x.fillStyle=Math.random()>0.94?'#f0d38a':'rgba(62,240,160,0.7)';
        x.fillText(g,i*fs,y);
        if(y>c.height&&Math.random()>0.975)drops[i]=0;
        drops[i]+=0.5;
      }
      requestAnimationFrame(draw);
    }
    if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches)draw();
  })();

  (function(){
    const el=document.getElementById('typed');
    const text='./hunt --target $YOUR_APP --think-like-attacker';
    let i=0;function type(){if(i<=text.length){el.textContent=text.slice(0,i);i++;setTimeout(type,50);}}
    setTimeout(type,700);
  })();

  (function(){
    const el=document.getElementById('hero-title');const final='HATRIX';const chars='#@%$&*ΞΨΩ01<>/';
    let frame=0;const total=40;
    function scramble(){
      let out='';
      for(let n=0;n<final.length;n++){
        if(frame/total*final.length>n){out+=final[n];}
        else{out+=chars[Math.floor(Math.random()*chars.length)];}
      }
      el.textContent=out;frame++;
      if(frame<=total)setTimeout(scramble,55);else el.textContent=final;
    }
    setTimeout(scramble,350);
  })();


  // smooth scroll for in-page anchor links
  document.querySelectorAll('a[href^="#"]').forEach(link=>{
    link.addEventListener('click', e=>{
      const id = link.getAttribute('href');
      const target = document.querySelector(id);
      if(target){ e.preventDefault(); target.scrollIntoView({behavior:'smooth', block:'start'}); }
    });
  });

  const nav=document.getElementById('nav');
  addEventListener('scroll',()=>{nav.classList.toggle('scrolled',scrollY>40);});

  const io=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{threshold:0.15});
  document.querySelectorAll('.reveal, .stat').forEach(el=>io.observe(el));

  const statsBox=document.getElementById('stats');let counted=false;
  const cio=new IntersectionObserver((es)=>{
    es.forEach(e=>{
      if(e.isIntersecting&&!counted){
        counted=true;
        document.querySelectorAll('.stat-num').forEach(num=>{
          const target=+num.dataset.target;const pre=num.dataset.prefix||'',suf=num.dataset.suffix||'';let cur=0;
          const step=()=>{cur+=Math.max(1,target/24);if(cur>=target){num.textContent=pre+target+suf;}else{num.textContent=pre+Math.floor(cur)+suf;requestAnimationFrame(step);}};
          step();
        });
      }
    });
  },{threshold:0.5});
  cio.observe(statsBox);
</script>

