<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HATRIX — Web & API Penetration Tester</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --void:#060605; --obsidian:#0b0a08; --basalt:#131210; --basalt-2:#1a1813;
    --gold:#cda349; --gold-bright:#f0d38a; --green:#3ef0a0; --green-dim:#1a7a52;
    --turquoise:#33c5be; --bone:#ece5d1; --muted:#847d6e; --line:#26231b;
    --crit:#ef5f52; --high:#f0b23e;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{background:var(--void); color:var(--bone); font-family:'Inter',sans-serif; line-height:1.6; overflow-x:hidden;}
  ::selection{background:rgba(62,240,160,0.25); color:#fff;}
  a{color:inherit; text-decoration:none;}
  .mono{font-family:'JetBrains Mono',monospace;}

  #matrix{position:fixed; inset:0; z-index:0; opacity:0.5; pointer-events:none;}
  .vignette{position:fixed; inset:0; z-index:1; pointer-events:none;
    background:radial-gradient(ellipse 80% 60% at 50% 0%, transparent 40%, rgba(6,6,5,0.72) 100%),
               radial-gradient(ellipse 100% 80% at 50% 120%, rgba(6,6,5,0.92), transparent 60%);}

  nav{position:fixed; top:0; left:0; right:0; z-index:100; display:flex; align-items:center; justify-content:space-between;
    padding:20px 6vw; transition:all 0.4s; border-bottom:1px solid transparent;}
  nav.scrolled{background:rgba(8,8,6,0.82); backdrop-filter:blur(14px); padding:14px 6vw; border-bottom:1px solid var(--line);}
  .brand{display:flex; align-items:center; gap:13px;}
  .brand-mark{width:32px; height:32px;}
  .brand-name{font-family:'Cinzel',serif; font-weight:700; font-size:1.25rem; letter-spacing:0.16em; color:var(--gold-bright);}
  .nav-links{display:flex; align-items:center; gap:34px;}
  .nav-links a{font-family:'JetBrains Mono',monospace; font-size:0.76rem; letter-spacing:0.06em; color:var(--muted); position:relative; transition:color 0.2s;}
  .nav-links a::after{content:''; position:absolute; left:0; bottom:-6px; width:0; height:1px; background:var(--green); transition:width 0.3s;}
  .nav-links a:hover{color:var(--green);}
  .nav-links a:hover::after{width:100%;}
  .nav-cta{font-family:'JetBrains Mono',monospace; font-size:0.76rem; letter-spacing:0.04em; padding:11px 22px;
    border:1px solid var(--green-dim); color:var(--green); border-radius:3px; transition:all 0.3s; position:relative; overflow:hidden;}
  .nav-cta span{position:relative; z-index:2;}
  .nav-cta::before{content:''; position:absolute; inset:0; background:var(--green); transform:translateY(101%); transition:transform 0.3s;}
  .nav-cta:hover{color:var(--void); border-color:var(--green);}
  .nav-cta:hover::before{transform:translateY(0);}

  .hero{position:relative; z-index:2; min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:140px 6vw 90px;}
  .terminal-line{font-family:'JetBrains Mono',monospace; font-size:0.82rem; letter-spacing:0.02em; color:var(--green); margin-bottom:30px; min-height:1.2em; opacity:0; animation:fadeUp 0.6s 0.2s forwards;}
  .terminal-line .prompt{color:var(--crit);}
  .cursor{display:inline-block; width:8px; height:1em; background:var(--green); margin-left:2px; vertical-align:text-bottom; animation:blink 1s steps(1) infinite;}
  @keyframes blink{50%{opacity:0;}}
  .hero h1{font-family:'Cinzel',serif; font-weight:900; font-size:clamp(3rem,12vw,9rem); letter-spacing:0.04em; line-height:0.95;
    background:linear-gradient(180deg,#fbe4b0 0%,var(--gold) 55%,#a97f2e 100%); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent;
    filter:drop-shadow(0 0 50px rgba(205,163,73,0.28));}
  .hero-tag{font-family:'JetBrains Mono',monospace; font-size:clamp(0.75rem,2vw,0.95rem); letter-spacing:0.32em; color:var(--crit); margin-top:22px; opacity:0; animation:fadeUp 0.7s 1.1s forwards;}
  .hero-sub{max-width:640px; margin:32px auto 0; font-size:1.08rem; color:var(--bone); opacity:0; animation:fadeUp 0.7s 1.3s forwards;}
  .hero-sub b{color:var(--gold-bright); font-weight:600;}
  .hero-ctas{margin-top:46px; display:flex; gap:16px; flex-wrap:wrap; justify-content:center; opacity:0; animation:fadeUp 0.7s 1.5s forwards;}
  @keyframes fadeUp{from{opacity:0; transform:translateY(22px);} to{opacity:1; transform:translateY(0);}}
  .btn{font-family:'JetBrains Mono',monospace; font-size:0.85rem; letter-spacing:0.04em; padding:15px 32px; border-radius:3px; transition:all 0.3s; position:relative; overflow:hidden; display:inline-flex; align-items:center; gap:10px;}
  .btn-primary{background:var(--green); color:var(--void); font-weight:600;}
  .btn-primary:hover{box-shadow:0 0 40px rgba(62,240,160,0.4); transform:translateY(-2px);}
  .btn-ghost{border:1px solid var(--line); color:var(--bone);}
  .btn-ghost:hover{border-color:var(--crit); color:var(--crit); transform:translateY(-2px);}
  .scroll-hint{position:absolute; bottom:34px; left:50%; transform:translateX(-50%); font-family:'JetBrains Mono',monospace; font-size:0.68rem; letter-spacing:0.2em; color:var(--muted); opacity:0; animation:fadeUp 1s 2s forwards; display:flex; flex-direction:column; align-items:center; gap:8px;}
  .scroll-hint .bar{width:1px; height:34px; background:linear-gradient(var(--green),transparent); animation:scrollBar 2s ease-in-out infinite;}
  @keyframes scrollBar{0%,100%{opacity:0.3; transform:scaleY(0.6);} 50%{opacity:1; transform:scaleY(1);}}

  .stats{position:relative; z-index:2; display:grid; grid-template-columns:repeat(4,1fr); border-top:1px solid var(--line); border-bottom:1px solid var(--line); background:rgba(19,18,16,0.7); backdrop-filter:blur(6px);}
  .stat{padding:42px 20px; text-align:center; border-right:1px solid var(--line); position:relative;}
  .stat:last-child{border-right:none;}
  .stat::before{content:''; position:absolute; top:0; left:50%; transform:translateX(-50%); width:0; height:2px; background:var(--green); transition:width 0.6s;}
  .stat.in::before{width:40%;}
  .stat-num{font-family:'JetBrains Mono',monospace; font-size:2.3rem; font-weight:700; color:var(--gold-bright);}
  .stat-label{margin-top:8px; font-size:0.74rem; letter-spacing:0.1em; text-transform:uppercase; color:var(--muted);}

  section{position:relative; z-index:2; padding:120px 6vw; max-width:1240px; margin:0 auto;}
  .section-head{margin-bottom:60px;}
  .section-head.center{text-align:center;}
  .eyebrow{display:inline-block; font-family:'JetBrains Mono',monospace; font-size:0.72rem; letter-spacing:0.26em; color:var(--crit); margin-bottom:16px; padding-left:36px; position:relative;}
  .eyebrow::before{content:''; position:absolute; left:0; top:50%; width:26px; height:1px; background:var(--crit);}
  .center .eyebrow{padding-left:0;}
  .center .eyebrow::before{display:none;}
  .section-title{font-family:'Cinzel',serif; font-weight:700; font-size:clamp(2rem,4.4vw,3rem); color:var(--gold-bright); letter-spacing:0.02em;}
  .section-desc{max-width:640px; margin:20px 0 0; color:var(--muted); font-size:1.02rem;}
  .center .section-desc{margin-left:auto; margin-right:auto;}

  /* SERVICES */
  .services-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--line); border:1px solid var(--line);}
  .service-card{background:var(--obsidian); padding:46px 34px; transition:background 0.4s; position:relative; overflow:hidden;}
  .service-card::after{content:''; position:absolute; top:0; left:0; width:100%; height:2px; background:linear-gradient(90deg,var(--crit),var(--gold)); transform:scaleX(0); transform-origin:left; transition:transform 0.4s;}
  .service-card:hover{background:var(--basalt-2);}
  .service-card:hover::after{transform:scaleX(1);}
  .svc-index{font-family:'JetBrains Mono',monospace; font-size:0.72rem; letter-spacing:0.1em; color:var(--crit); margin-bottom:20px;}
  .service-icon{width:38px; height:38px; margin-bottom:22px; color:var(--green); transition:transform 0.4s;}
  .service-card:hover .service-icon{transform:translateY(-4px) rotate(-4deg);}
  .service-card h3{font-family:'Cinzel',serif; font-size:1.2rem; color:var(--gold-bright); margin-bottom:14px;}
  .service-card p{color:var(--muted); font-size:0.93rem;}

  /* KILL LOG */
  .killlog{display:flex; flex-direction:column; gap:18px;}
  .kl-entry{background:linear-gradient(150deg,var(--basalt),var(--obsidian)); border:1px solid var(--line); border-radius:5px; overflow:hidden; transition:border-color 0.3s, transform 0.3s;}
  .kl-entry:hover{border-color:var(--green-dim); transform:translateY(-3px);}
  .kl-header{display:flex; align-items:center; gap:16px; padding:16px 24px; border-bottom:1px solid var(--line); background:rgba(0,0,0,0.25); flex-wrap:wrap;}
  .kl-sev{font-family:'JetBrains Mono',monospace; font-size:0.7rem; font-weight:700; letter-spacing:0.08em; padding:4px 11px; border-radius:3px;}
  .sev-crit{background:rgba(239,95,82,0.14); color:var(--crit); border:1px solid rgba(239,95,82,0.4);}
  .sev-high{background:rgba(240,178,62,0.12); color:var(--high); border:1px solid rgba(240,178,62,0.35);}
  .kl-target{font-family:'JetBrains Mono',monospace; font-size:0.8rem; color:var(--muted); letter-spacing:0.03em;}
  .kl-target .redact{color:var(--bone); letter-spacing:0.1em;}
  .kl-cvss{margin-left:auto; font-family:'JetBrains Mono',monospace; font-size:0.82rem; font-weight:700; color:var(--gold-bright);}
  .kl-body{padding:22px 24px; font-family:'JetBrains Mono',monospace; font-size:0.86rem;}
  .kl-cmd{color:var(--green); margin-bottom:12px;}
  .kl-cmd::before{content:'$ '; color:var(--crit);}
  .kl-desc{color:var(--bone); font-family:'Inter',sans-serif; font-size:0.94rem; line-height:1.65; margin-bottom:16px; opacity:0.86;}
  .kl-result{color:var(--muted); display:flex; gap:10px; align-items:baseline; flex-wrap:wrap;}
  .kl-tag{color:var(--gold); font-size:0.72rem; letter-spacing:0.06em; border:1px solid var(--line); padding:2px 8px; border-radius:2px; flex-shrink:0;}
  .kl-status{margin-top:14px; font-size:0.78rem; color:var(--green-dim); display:flex; align-items:center; gap:8px;}
  .kl-dot{width:7px; height:7px; border-radius:50%; background:var(--green); box-shadow:0 0 8px var(--green);}

  /* PROCESS timeline */
  .timeline{position:relative; padding-left:44px;}
  .timeline::before{content:''; position:absolute; left:13px; top:8px; bottom:8px; width:2px; background:linear-gradient(var(--crit),var(--gold),var(--green-dim));}
  .tl-step{position:relative; padding:0 0 46px 0;}
  .tl-step:last-child{padding-bottom:0;}
  .tl-dot{position:absolute; left:-44px; top:2px; width:28px; height:28px; border-radius:50%; background:var(--void); border:2px solid var(--gold); display:flex; align-items:center; justify-content:center; font-family:'JetBrains Mono',monospace; font-size:0.72rem; color:var(--gold-bright); transition:all 0.3s;}
  .tl-step:hover .tl-dot{border-color:var(--green); color:var(--green); box-shadow:0 0 16px rgba(62,240,160,0.4);}
  .tl-step h4{font-family:'Cinzel',serif; font-size:1.18rem; color:var(--gold-bright); margin-bottom:8px;}
  .tl-step p{color:var(--muted); font-size:0.96rem; max-width:600px;}

  .trust{text-align:center; padding:76px 6vw; border-top:1px solid var(--line); border-bottom:1px solid var(--line); background:rgba(19,18,16,0.6); position:relative; z-index:2;}
  .trust-label{font-family:'JetBrains Mono',monospace; font-size:0.72rem; letter-spacing:0.24em; color:var(--muted); margin-bottom:28px;}
  .trust-platforms{display:flex; justify-content:center; gap:48px; flex-wrap:wrap;}
  .trust-platforms span{font-family:'JetBrains Mono',monospace; font-size:0.98rem; color:var(--bone); opacity:0.5; transition:all 0.3s;}
  .trust-platforms span:hover{opacity:1; color:var(--green); transform:translateY(-3px);}

  .contact{text-align:center; padding:140px 6vw;}
  .contact .section-title{font-size:clamp(2.2rem,5vw,3.4rem);}
  .contact-desc{max-width:520px; margin:22px auto 42px; color:var(--muted); font-size:1.05rem;}
  .contact-mark{width:56px; height:56px; margin:0 auto 30px; color:var(--gold); opacity:0.9;}
  .contact-alt{margin-top:30px; font-family:'JetBrains Mono',monospace; font-size:0.82rem; color:var(--muted); display:flex; gap:14px; justify-content:center; align-items:center; flex-wrap:wrap;}
  .contact-alt a{color:var(--muted); transition:color 0.25s;}
  .contact-alt a:hover{color:var(--green);}
  .contact-alt .sep{opacity:0.5;}

  .footer-links{display:flex; gap:22px;}
  .footer-links a{color:var(--muted); transition:color 0.2s;}
  .footer-links a:hover{color:var(--green);}
  footer{padding:34px 6vw; border-top:1px solid var(--line); display:flex; justify-content:space-between; align-items:center; font-family:'JetBrains Mono',monospace; font-size:0.74rem; color:var(--muted); flex-wrap:wrap; gap:12px; position:relative; z-index:2;}

  .reveal{opacity:0; transform:translateY(30px); transition:opacity 0.8s ease, transform 0.8s ease;}
  .reveal.in{opacity:1; transform:translateY(0);}
  .reveal.d1{transition-delay:0.1s;} .reveal.d2{transition-delay:0.2s;}

  @media (prefers-reduced-motion: reduce){*{animation:none !important; transition:none !important;} .reveal{opacity:1; transform:none;} #matrix{display:none;}}
  @media (max-width:860px){
    .nav-links{display:none;}
    .services-grid{grid-template-columns:1fr;}
    .stats{grid-template-columns:repeat(2,1fr);}
    .stat:nth-child(-n+2){border-bottom:1px solid var(--line);}
    .stat:nth-child(2){border-right:none;}
    .kl-cvss{margin-left:0; width:100%;}
  }
</style>
</head>
